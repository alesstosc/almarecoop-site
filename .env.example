# Copia questo file in .env e compila i valori. NON versionare mai .env.

# Obbligatoria: senza questa l'applicazione non parte.
# Genera un valore con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Alternativa a SQLite (default: instance/database.db)
# DATABASE_URL=postgresql+psycopg2://utente:password@localhost:5432/nomedb

# Invio email notifiche dai form
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
ADMIN_EMAIL=admin@example.com

# Solo sviluppo: abilita il debug server
FLASK_DEBUG=0
